{
  "name": "aim-practice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Original browser-based 3D aim trainer (M0-M2 foundation)",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
